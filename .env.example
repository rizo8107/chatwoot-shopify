# PostgreSQL database — REQUIRED. URL-encode reserved password characters.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Set false for PostgreSQL servers that do not provide TLS.
DATABASE_SSL=true

# App session signing secret (optional — derived from DATABASE_URL if unset)
# AUTH_SECRET=

# Development API port. Production can override this (Docker uses 3000).
PORT=3001
